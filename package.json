    "@pancakeswap/smart-router": "^7.6.1",
    "@pancakeswap/tokens": "0.8.0",
    "@rainbow-me/rainbowkit": "^2.1.0",
    "@supabase/supabase-js": "^2.40.0",
    "@tanstack/react-query": "^5.28.0",
    "grammy": "^1.22.0",
    "lucide-react": "^1.33.0",
