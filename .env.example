# Agent Bazaar - Environment Variables
# Copy to .env.local and fill in your values

# Supabase (get from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username

# Telegram Mini App
NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=https://your-app.vercel.app

# Wallet / RainbowKit
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your-walletconnect-project-id

# BNB Chain
NEXT_PUBLIC_BNB_CHAIN_ID=56
NEXT_PUBLIC_BNB_TESTNET_CHAIN_ID=97

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=Agent Bazaar

# Optional: Analytics, Error tracking
# NEXT_PUBLIC_POSTHOG_KEY=
# SENTRY_DSN=

# 8004scan (real ERC-8004 agent indexing — Fase 1, get from 8004scan.io/developers)
EIGHTOOFOURSCAN_API_KEY=your-8004scan-api-key

# Onchain operator wallet (Fase 4) — registers listed agents on the ERC-8004
# IdentityRegistry via @bnbagent/sdk. Gas-free via MegaFuel paymaster, so this
# address needs no BNB balance. Generate a fresh keypair per environment
# (e.g. `node -e "console.log(require('viem/accounts').generatePrivateKey())"`)
# and never reuse a testnet operator key on mainnet.
BNBAGENT_NETWORK=bsc-testnet
BNBAGENT_OPERATOR_PRIVATE_KEY=your-operator-private-key
BNBAGENT_OPERATOR_ADDRESS=your-operator-address
BNBAGENT_OPERATOR_WALLET_PASSWORD=your-keystore-encryption-password

# Cloudflare Workers AI (Concierge — semantic search embeddings, free tier, no OpenAI key needed)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token